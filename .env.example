# mancar configuration. Copy to .env and fill in the seven variables below
# (scripts/setup.sh does the copying and generates the three secrets for you).
# Everything else has a safe default; optional settings are listed at the end.
#
# NEVER commit .env: it contains secrets. It is listed in .gitignore.

# production (default) or development.
APP_ENV=production

# The domain you control and that tunnels hang off, e.g. tunnel.example.com.
# Needs two DNS records pointing at this server (see docs/DEPLOYMENT.md):
#   A  @  <server public IP>      A  *  <server public IP>      (DNS only, not proxied)
BASE_DOMAIN=

# Contact address for Let's Encrypt expiry notices.
ACME_EMAIL=

# Cloudflare API token with ONLY "Zone / DNS / Edit" on the zone of BASE_DOMAIN.
# Used to answer the DNS-01 challenge for the wildcard certificate.
CLOUDFLARE_API_TOKEN=

# Secrets: leave empty and run scripts/setup.sh, or generate each yourself:
#   openssl rand -hex 32
# Generate them once. Do not change ENCRYPTION_KEY later without a migration plan.
JWT_SECRET=
ENCRYPTION_KEY=
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Optional settings (uncomment to change; defaults shown)
# ---------------------------------------------------------------------------
# LOG_LEVEL=info                          # debug | info | warn | error
# TCP_PORT_MIN=20000                      # public port range for TCP tunnels
# TCP_PORT_MAX=20099                      #   (each port is published by Docker)
# MAX_TUNNELS_PER_AGENT=10
# MAX_AGENTS_PER_USER=10
# MAX_CONNECTIONS_PER_TUNNEL=256
# MAX_REQUEST_BODY_BYTES=104857600        # 0 = unlimited
# RESPONSE_HEADER_TIMEOUT=2m
# HOSTNAME_HOLD_CUSTOM=24h                # how long a custom name stays reserved
# HOSTNAME_HOLD_RANDOM=5m                 #   after its tunnel disconnects
# AUTH_FAILURE_LIMIT_PER_MINUTE=10        # failed agent logins per client address; 0 = off
# MANCAR_VERSION=latest                 # image tag to run (pin a release in production)
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory   # staging CA while testing
